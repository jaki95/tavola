TAVOLA_APP_NAME=Tavola API
TAVOLA_ENVIRONMENT=local
TAVOLA_API_PREFIX=/api

# Planner defaults keep live Codex disabled unless explicitly opted in.
TAVOLA_PLANNER_CODEX_ENABLED=false
TAVOLA_PLANNER_CODEX_MODEL=gpt-5.5
TAVOLA_PLANNER_CODEX_SANDBOX_MODE=read-only
TAVOLA_PLANNER_CODEX_REASONING_EFFORT=low
TAVOLA_PLANNER_CODEX_TIMEOUT_SECONDS=60
TAVOLA_PLANNER_CODEX_MAX_RETRIES=0
TAVOLA_PLANNER_CODEX_MISSING_CREDENTIALS=disable
TAVOLA_PLANNER_CODEX_CREDENTIALS_CONFIGURED=false

# Set OPENAI_API_KEY in your local shell or secret manager when using API-key
# authentication. Do not commit real credentials.
# OPENAI_API_KEY=
